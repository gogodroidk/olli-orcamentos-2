{
  "name": "OLLI — Painel",
  "short_name": "OLLI",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "lang": "pt-BR",
  "background_color": "#ffffff",
  "theme_color": "#0b6bcb",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/compartilhar-contato",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "contatos", "accept": ["text/vcard", "text/x-vcard", ".vcf"] }]
    }
  }
}
