{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"useDefineForClassFields": true,
		"skipLibCheck": true,
		"allowJs": true,
		"moduleResolution": "bundler",
		"sourceMap": true,
		"declaration": true,
		"preserveWatchOutput": true,
		"removeComments": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,

		"strict": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"useUnknownInCatchVariables": false,

		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"#/*": ["src/types/*"],

			// PONTE DE DOMÍNIO — aponta para os tipos do APP DO CELULAR (../src/types).
			// Por que: o painel grava nas MESMAS tabelas que o app, e a coluna `dados`
			// (jsonb) guarda o objeto de domínio INTEIRO. Se o painel tivesse uma cópia
			// própria dos tipos, as duas divergiriam com o tempo e o painel passaria a
			// gravar um blob que o app não sabe ler — corrompendo o dado do cliente.
			// Importando daqui, divergir vira erro de compilação.
			// É seguro: `src/types/index.ts` é TypeScript puro (só type-importa
			// `services/verticais`, que não importa nada) — não arrasta React Native.
			"@dominio": ["../src/types/index.ts"],

			// FONTE DE PREÇO — o painel NÃO redigita valor de R$: importa a mesma
			// `web/src/data/planos.ts` que a landing usa (conferida contra a Stripe
			// live). Preço errado é a copy mais cara de errar (CDC art. 37), então
			// mora num lugar só. É seguro: o arquivo é TypeScript puro, zero imports.
			"@precos": ["../web/src/data/planos.ts"],

			// FONTE DE ENTITLEMENTS — "que plano libera o quê" vem do MESMO mapa que o
			// app e o worker leem (`src/services/entitlements.ts`), para o comparativo
			// nunca prometer recurso que o produto não entrega. Módulo puro, zero imports.
			"@entitlements": ["../src/services/entitlements.ts"],
			// LEMBRETE DE ASSINATURA — a MESMA regra de "que lembrete de pagar esta conta vê"
			// que o app usa, para painel e celular nunca cobrarem diferente. Módulo puro.
			"@lembreteAssinatura": ["../src/services/lembreteAssinatura.ts"],
			// RADAR DE DINHEIRO — a MESMA regra de dinheiro parado / proposta parada /
			// cliente sumido que o resumo diário por e-mail (worker) usa. Módulo puro.
			"@radar-dinheiro": ["../src/services/radarDinheiro.ts"],
			// RESUMO POR E-MAIL — textos e leitura do botão "Receber resumo diário por e-mail",
			// iguais aos do app (Conta → Notificações). Módulo puro, zero imports.
			"@resumo-email": ["../src/services/resumoEmailPreferencia.ts"],
			"@plano-efetivo": ["../src/services/planoEfetivo.ts"],
			"@verticais": ["../src/services/verticais.ts"],
			"@vertical-segmento": ["../src/services/verticalSegmento.ts"],
			"@limites-comerciais": ["../src/services/limitesComerciais.ts"],
			// ATIVAÇÃO — exemplo de orçamento por ofício, checklist e aviso do teste do Pro:
			// a MESMA regra do app (src/services/ativacao.ts). Módulo puro.
			"@ativacao": ["../src/services/ativacao.ts"],
			// DOCUMENTOS DE OFÍCIO — campos exigidos (RDC 622/2022, Lei SP 10.770/1989) e o
			// rascunho do comprovante de pragas e do certificado de caixa d'água: a MESMA
			// lista que o app confere antes de gerar o PDF. Módulo puro (só type-importa verticais).
			"@documentos-oficio": ["../src/services/documentosOficio.ts"],
			"@ia-segura": ["../src/services/olliAcoesSeguras.ts"],
			"@precificacao": ["../src/services/precificacao.ts"],
			"@auth-policy": ["../src/services/authPolicy.ts"],
			"@oauth-retorno": ["../src/services/oauthRetorno.ts"],
			"@acesso-codigo": ["../src/services/acessoCodigo.ts"],
			"@sentry-scrub": ["../src/services/sentryScrub.ts"],
			"@sentry-captura": ["../src/services/sentryCaptura.ts"],
			"@ajuda": ["../src/content/ajuda/index.ts"],
			// ASSINATURA PELA GOOGLE PLAY — catálogo e URL de gerenciar, os mesmos do app
			// e do worker (src/services/playBillingRegras.ts). Módulo puro, zero imports.
			"@play-billing-regras": ["../src/services/playBillingRegras.ts"],


			// MARKETING — origem da visita (UTM) e Meta Pixel. Mesma fonte da landing
			// (`web/src/lib`), para o ID do Pixel e as regras de first/last-touch não
			// divergirem entre os dois sites. TypeScript puro, zero imports.
			"@atribuicao": ["../web/src/lib/atribuicao.ts"],
			"@meta-pixel": ["../web/src/lib/metaPixel.ts"],
			"@consentimento": ["../web/src/lib/consentimento.ts"],
			"@google-tag": ["../web/src/lib/googleTag.ts"],
			// LISTA DE ORÇAMENTOS — filtro e ordem (status, data, valor, cliente, busca).
			// A MESMA regra do app (src/utils/listaOrcamentos.ts). Módulo puro: só importa
			// a busca sem acento de consultasSql.ts, sem React Native.
			"@lista-orcamentos": ["../src/utils/listaOrcamentos.ts"]
		}
	},
	"include": ["src", "src/types", "tailwind.config.ts"],
	"exclude": ["node_modules", "dist"]
}
