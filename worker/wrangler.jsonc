{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olli-diagnostico",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  // nodejs_compat é EXIGIDO pelo @sentry/cloudflare: o SDK precisa de
  // AsyncLocalStorage para propagar o escopo entre await. Sem esta flag o
  // deploy PASSA e o worker quebra em runtime.
  //
  // ATENÇÃO — isto muda o RUNTIME de um backend vivo (pagamentos/webhooks/IA):
  // adiciona globais do Node e altera resolução de módulos. Não é cosmético.
  // Antes do primeiro deploy com esta flag, confira que as rotas de pagamento
  // continuam respondendo (ver README).
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Estes domínios já pertencem ao Worker em produção. Mantê-los no arquivo
  // evita que um deploy por Wrangler apague configuração criada no Dashboard.
  "routes": [
    {
      "pattern": "diagnostico.olliorcamentos.online",
      "zone_name": "olliorcamentos.online",
      "custom_domain": true
    },
    {
      "pattern": "link.olliorcamentos.online",
      "zone_name": "olliorcamentos.online",
      "custom_domain": true
    }
  ],
  // Cron de minuto: consumer da outbox (boas-vindas + lembretes + resumo) a cada
  // minuto; a seleção de lembretes só age na hora cheia, 8h–20h de Brasília, e a
  // do resumo diário de 10 em 10 min entre 7h00 e 7h50 (seg–sáb).
  "triggers": { "crons": ["* * * * *"] },
  // Variáveis PÚBLICAS (não-secretas). Chaves ficam como secret:
  //   npx wrangler secret put OPENROUTER_API_KEY
  //   npx wrangler secret put STRIPE_SECRET_KEY       (sk_live_...)
  //   npx wrangler secret put STRIPE_WEBHOOK_SECRET   (whsec_..., do endpoint do webhook)
  //   npx wrangler secret put RESEND_WEBHOOK_SECRET   (whsec_..., do endpoint Svix do Resend)
  "vars": {
    "SUPABASE_URL": "https://yiaeplqinnnnniyvwtls.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_uDltTEnZAUek_YYGFhKaUw_q0DNu_6_", // gitleaks:allow — chave publicável, protegida por RLS
    // E-mail REAL ligado (dono autorizou em 29/09/2026). Só linhas novas da
    // outbox nascem scope=production (config no banco, migration 20260929200000);
    // as boas-vindas antigas presas em hold foram descartadas sem envio.
    "WELCOME_DISPATCH_MODE": "production",
    // Envio sequencial por minuto; folga grande sob o limite de taxa da Resend.
    "WELCOME_BATCH_LIMIT": "3",
    "WELCOME_FROM": "OLLI Orçamentos <nao-responda@olliorcamentos.online>",
    "WELCOME_REPLY_TO": "contato@olliorcamentos.online",
    "WELCOME_APP_URL": "https://app.olliorcamentos.online",
    "WELCOME_SUPPORT_URL": "https://olliorcamentos.online/ajuda/",
    "WELCOME_LOGO_URL": "https://olliorcamentos.online/icon-192.png",
    // E-mails de autenticação (POST /auth/email-hook, Send Email Hook do Supabase).
    // Remetente/logo/suporte são os WELCOME_* acima. O link de todo e-mail de auth
    // aponta para esta página do painel (?token_hash=&type=&next=). A validade TEM
    // de ser igual a mailer_otp_exp/60 do Supabase — é o que o e-mail promete.
    // O segredo do hook é secret: npx wrangler secret put SEND_EMAIL_HOOK_SECRET
    "AUTH_EMAIL_CONFIRM_URL": "https://app.olliorcamentos.online/auth/confirm",
    "AUTH_OTP_VALIDADE_MINUTOS": "10",
    // Lembretes por e-mail (ativação D+3/D+7 e assinatura). Tetos conservadores:
    // 3 por rodada horária, 40 por dia no total, ativação só até 30 dias de conta.
    "EMAIL_LEMBRETES_MODE": "production",
    "EMAIL_LEMBRETES_MAX_POR_RODADA": "3",
    "EMAIL_LEMBRETES_TETO_DIARIO": "40",
    "EMAIL_LEMBRETES_ATIVACAO_MAX_DIAS": "30",
    "EMAIL_DESCADASTRO_URL": "https://diagnostico.olliorcamentos.online/email/descadastrar",
    // Resumo diário do dinheiro parado (7h–8h de Brasília, seg–sáb, só com algo
    // acionável; opt-out com link próprio). Precisa da migration 20260930120000.
    // Começo conservador: no máximo 3 por semana por conta, 44 h entre dois resumos,
    // 8 por rodada de 10 min e 100 por dia no total. "off" desliga sem mexer no banco.
    "EMAIL_RESUMO_MODE": "production",
    "EMAIL_RESUMO_MAX_SEMANA": "3",
    "EMAIL_RESUMO_INTERVALO_MIN_HORAS": "44",
    "EMAIL_RESUMO_MAX_POR_RODADA": "8",
    "EMAIL_RESUMO_MAX_AVALIACOES": "15",
    "EMAIL_RESUMO_TETO_DIARIO": "100",
    // Motor de contrato recorrente (cron 06:05/12:05/18:05 de Brasília): gera as
    // visitas devidas mesmo sem ninguém abrir o app. DESLIGADO até a migration
    // 20260930130500 estar aplicada; aí trocar para "production". 10 visitas por
    // rodada (~4 requisições cada) cabem folgadas no limite de subrequests.
    "CONTRATOS_MOTOR_MODE": "off",
    "CONTRATOS_MOTOR_MAX_CONTRATOS": "200",
    "CONTRATOS_MOTOR_MAX_VISITAS": "10",
    "AI_PROVIDER": "openrouter",
    // Cadeia PAGA barata (dono autorizou em 29/09/2026): os :free morreram sob
    // data_collection=deny. Só funciona com OPENROUTER_PERMITIR_PAGO="true" E
    // com cada ID na allowlist de worker/src/ai.js, que também manda o teto de
    // preço (max_price) em toda request. Mesma ordem de OPENROUTER_MODELOS_PADRAO
    // — `npm run check:ai-models` (raiz) exige igualdade e valida ao vivo.
    "OPENROUTER_TEXT_MODELS": "openai/gpt-4.1-nano,openai/gpt-4o-mini,mistralai/mistral-small-24b-instruct-2501",
    "OPENROUTER_PERMITIR_PAGO": "true",
    "OPENROUTER_SITE_URL": "https://olliorcamentos.online",
    "OPENROUTER_APP_NAME": "OLLI Orcamentos",
    // Reservas diárias pessimistas: uma tentativa enviada ao provedor conta
    // mesmo se terminar em timeout/429. Há margem para outras automações.
    // Estes tetos SÃO o teto de gasto da IA paga (cada tentativa = 1 unidade):
    //   típico  (~1,5k tokens in / 400 out): ~US$ 0,0003 × 500 ≈ US$ 0,15/dia
    //   pior caso (32k in / 4.096 out, no teto de preço 0,12/0,48 por milhão):
    //            ~US$ 0,0058 × 500 ≈ US$ 2,90/dia (~US$ 87/mês)
    // Subir o GLOBAL sobe esse teto na mesma proporção. Recomendado também um
    // limite de crédito na própria chave do OpenRouter (painel), como 2ª trava.
    "OPENROUTER_GLOBAL_DAILY_LIMIT": "500",
    "OPENROUTER_USER_DAILY_LIMIT": "100",
    // Whisper é contado em neurônios estimados, não em requests. 46,63/min;
    // 8.000 ≈ 171 min/dia e 940 ≈ 20 min/dia por usuário.
    "WHISPER_GLOBAL_DAILY_LIMIT": "8000",
    "WHISPER_USER_DAILY_LIMIT": "940",
    // Mantido apenas para rollback deliberado com AI_PROVIDER=gemini.
    "GEMINI_MODEL": "gemini-2.5-flash",
    // Price IDs da Stripe (não-secretos — identificam produtos, não autenticam).
    // Pro = R$39/mês (lookup olli_pro_mensal); Empresa = R$99/mês (lookup
    // olli_empresa_mensal, ainda NÃO vendido no checkout — só contato).
    "STRIPE_PRICE_PRO": "price_1TqUOA4zjAI9pGd77ZyOCYcQ",
    "STRIPE_PRICE_PRO_ANUAL": "price_1TqUVb4zjAI9pGd7fGSU4b4v",
    "STRIPE_PRICE_PRO_12X": "price_1TqkxK4zjAI9pGd7OMdgMrIE",
    "STRIPE_PRICE_EMPRESA": "price_1TqUOB4zjAI9pGd7Lj4ETRM6",
    "STRIPE_PRICE_EMPRESA_ANUAL": "price_1TqkxJ4zjAI9pGd7WyiqYhrn",
    "MP_WEBHOOK_REQUIRE_SIGNATURE": "true"
  },
  // Staging is a separate Worker with no production custom domains. It inherits
  // the bindings/rate-limit shape above but overrides all environment identity
  // and Supabase routing. Secrets are provisioned separately with
  // `wrangler secret put --env staging`; no production secret is inherited.
  "env": {
    "staging": {
      "name": "olli-diagnostico-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "SUPABASE_URL": "https://sbpkutknpywezeagioon.supabase.co",
        "SUPABASE_ANON_KEY": "sb_publishable_4QaDViGbT45F72jQ5GINug_UN-4alDT", // gitleaks:allow — chave publicável, protegida por RLS
        "WELCOME_DISPATCH_MODE": "off",
        "WELCOME_BATCH_LIMIT": "1",
        "EMAIL_LEMBRETES_MODE": "off",
        "EMAIL_RESUMO_MODE": "off",
        "CONTRATOS_MOTOR_MODE": "off",
        "WELCOME_FROM": "OLLI Orçamentos <nao-responda@olliorcamentos.online>",
        "WELCOME_REPLY_TO": "contato@olliorcamentos.online",
        "WELCOME_APP_URL": "https://staging.app.olliorcamentos.online",
        "WELCOME_SUPPORT_URL": "https://olliorcamentos.online/ajuda/",
        "WELCOME_LOGO_URL": "https://olliorcamentos.online/icon-192.png",
        "AUTH_EMAIL_CONFIRM_URL": "https://staging.app.olliorcamentos.online/auth/confirm",
        "AUTH_OTP_VALIDADE_MINUTOS": "10",
        "AI_PROVIDER": "openrouter",
        "AUTOPILOT_WORKERS_AI_ENABLED": "true",
        "OPENROUTER_TEXT_MODELS": "openai/gpt-4.1-nano,openai/gpt-4o-mini,mistralai/mistral-small-24b-instruct-2501",
        "OPENROUTER_PERMITIR_PAGO": "true",
        "OPENROUTER_SITE_URL": "https://staging.olliorcamentos.online",
        "OPENROUTER_APP_NAME": "OLLI Orcamentos Staging",
        "OPENROUTER_GLOBAL_DAILY_LIMIT": "500",
        "OPENROUTER_USER_DAILY_LIMIT": "100",
        "WHISPER_GLOBAL_DAILY_LIMIT": "8000",
        "WHISPER_USER_DAILY_LIMIT": "940",
        "GEMINI_MODEL": "gemini-2.5-flash",
        "STRIPE_PRICE_PRO": "price_1TqUOA4zjAI9pGd77ZyOCYcQ",
        "STRIPE_PRICE_PRO_ANUAL": "price_1TqUVb4zjAI9pGd7fGSU4b4v",
        "STRIPE_PRICE_PRO_12X": "price_1TqkxK4zjAI9pGd7OMdgMrIE",
        "STRIPE_PRICE_EMPRESA": "price_1TqUOB4zjAI9pGd7Lj4ETRM6",
        "STRIPE_PRICE_EMPRESA_ANUAL": "price_1TqkxJ4zjAI9pGd7WyiqYhrn",
        "MP_WEBHOOK_REQUIRE_SIGNATURE": "true"
      },
      "ai": { "binding": "AI" },
      "ratelimits": [
        { "name": "IA_RL", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        { "name": "LINK_RL", "namespace_id": "2002", "simple": { "limit": 12, "period": 60 } },
        { "name": "STRIPE_RL", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "ADMIN_RL", "namespace_id": "2004", "simple": { "limit": 30, "period": 60 } },
        { "name": "ETA_RL", "namespace_id": "2005", "simple": { "limit": 20, "period": 60 } },
        { "name": "CNPJ_RL", "namespace_id": "2006", "simple": { "limit": 20, "period": 60 } },
        { "name": "MP_RL", "namespace_id": "2008", "simple": { "limit": 12, "period": 60 } },
        { "name": "TRANSCREVER_RL", "namespace_id": "2009", "simple": { "limit": 20, "period": 60 } },
        { "name": "MPHOOK_RL", "namespace_id": "2010", "simple": { "limit": 120, "period": 60 } },
        { "name": "CEP_RL", "namespace_id": "2011", "simple": { "limit": 30, "period": 60 } },
        { "name": "ABACATE_RL", "namespace_id": "2012", "simple": { "limit": 12, "period": 60 } },
        { "name": "ABACATEHOOK_RL", "namespace_id": "2013", "simple": { "limit": 60, "period": 60 } },
        { "name": "RCHOOK_RL", "namespace_id": "2014", "simple": { "limit": 60, "period": 60 } },
        { "name": "AUTH_EMAIL_RL", "namespace_id": "2021", "simple": { "limit": 5, "period": 60 } },
        { "name": "CLIMA_RL", "namespace_id": "2030", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  },
  // O áudio fica na Cloudflare; somente a transcrição textual segue ao
  // OpenRouter quando o modo solicitado é orçamento.
  "ai": { "binding": "AI" },
  // Rate limiting nativo da Cloudflare. Protege a cota paga da IA (por usuário) e
  // o link público contra abuso/brute-force (por IP). period: 10 ou 60 (segundos).
  "ratelimits": [
    { "name": "IA_RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "LINK_RL", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } },
    // Rotas Stripe (checkout/portal) por usuário: barra criação em massa de
    // sessões. Não cobre o webhook (esse é servidor-a-servidor da Stripe).
    { "name": "STRIPE_RL", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    // /admin/api/* por IP: barra força bruta/varredura de credencial contra o
    // painel do super-admin (acesso total a dados de todos os usuários).
    { "name": "ADMIN_RL", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    // /eta e /geocodificar por usuário: são as ÚNICAS rotas que geram custo no
    // Google Routes/Geocoding API — sem teto, qualquer conta grátis dispara
    // chamadas pagas ilimitadas. Mesmo perfil do IA_RL.
    { "name": "ETA_RL", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
    // /cnpj por usuário: consulta a BrasilAPI (grátis, mas com fair-use) e evita
    // que usem o worker pra raspar CNPJ em massa. Baixo volume (cadastro), teto folgado.
    { "name": "CNPJ_RL", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
    // (namespace_id 1007 era o ABACATE_RL, removido junto com o AbacatePay —
    // provedor de Pix sem nenhum chamador. Não reaproveitar o id: manter o buraco
    // deixa claro que o binding saiu de propósito.)
    // Rotas Mercado Pago (criar cobrança Pix/status) por usuário. Não
    // cobre o webhook (servidor-a-servidor do MP, autenticado por x-signature).
    { "name": "MP_RL", "namespace_id": "1008", "simple": { "limit": 12, "period": 60 } },
    // /transcrever por IP (B1/O2-18): complementa o IA_RL (que é por usuário) —
    // barra abuso via várias contas atrás do mesmo IP no endpoint de maior corpo
    // (áudio, até 4MB) e maior custo por chamada. Checado ANTES de bufferizar.
    { "name": "TRANSCREVER_RL", "namespace_id": "1009", "simple": { "limit": 20, "period": 60 } },
    // /mp/webhook por IP, SÓ no caminho não-assinado (enquanto MP_WEBHOOK_SECRET
    // não estiver no cofre). Sem isto a rota é pública e sem teto, e cada POST
    // dispara um GET à API do Mercado Pago com o token de PRODUÇÃO do dono — um
    // estranho consegue esgotar/derrubar o token que confirma os Pix pagos.
    // Teto ALTO de propósito: o volume real de webhook do MP é de unidades por
    // minuto, e 429 aqui só faz o MP REENVIAR (nenhum pagamento se perde).
    { "name": "MPHOOK_RL", "namespace_id": "1010", "simple": { "limit": 120, "period": 60 } },
    // /cep por usuário. O upstream é GRÁTIS (BrasilAPI + ViaCEP), então isto não
    // protege fatura — protege o fair-use de um projeto comunitário sem SLA e
    // impede que o worker vire ferramenta de raspagem de base de CEP em nome do
    // OLLI. Teto folgado de propósito: o uso legítimo é 1 consulta por cliente
    // novo, e acerto de cache nem chega aqui (é conferido ANTES — ver brasil.js).
    // Enquanto o binding não for provisionado por um deploy, `checarLimite`
    // devolve `indisponivel` e a rota SEGUE (política `sensivel:false`), porque
    // derrubar cadastro de cliente por causa de limitador ausente seria pior que
    // o abuso que ele previne. /feriados não tem binding: não chama ninguém.
    { "name": "CEP_RL", "namespace_id": "1011", "simple": { "limit": 30, "period": 60 } },
    // Pix de plano AbacatePay (criar cobrança/status) por usuário. Id novo de
    // propósito: o 1007 foi do ABACATE_RL antigo e não se reaproveita.
    { "name": "ABACATE_RL", "namespace_id": "1012", "simple": { "limit": 12, "period": 60 } },
    // /abacate/webhook por IP, conferido ANTES do `?webhookSecret=`: barra
    // tentativa de adivinhar o segredo e a amplificação se ele vazar. Teto alto de
    // propósito (volume real: unidades por dia); 429 só faz a AbacatePay reenviar.
    // Id novo (1013): não reaproveita o 1007.
    { "name": "ABACATEHOOK_RL", "namespace_id": "1013", "simple": { "limit": 60, "period": 60 } },
    // /revenuecat/webhook por IP, conferido ANTES do Authorization secreto: barra
    // quem tenta adivinhar o segredo. Teto alto de propósito (volume real: poucos
    // eventos por assinante por mês); 429 só faz o RevenueCat reenviar.
    { "name": "RCHOOK_RL", "namespace_id": "1014", "simple": { "limit": 60, "period": 60 } },
    // /auth/email-hook por DESTINATÁRIO (hash do e-mail), conferido depois da
    // assinatura: barra que um cadastro/"esqueci a senha" em loop vire bombardeio
    // na caixa de alguém e queime a cota da Resend. O próprio Supabase já segura
    // 1 pedido/min por usuário; 5/min aqui é folga para as duas pontas da troca
    // de e-mail e reenvios. Fail-closed: sem o binding, a rota responde 503.
    // Id 1021 (faixa 102x = Auth), longe dos 101x para não colidir com PR paralelo.
    { "name": "AUTH_EMAIL_RL", "namespace_id": "1021", "simple": { "limit": 5, "period": 60 } },
    // /clima por IP (rota pública, sem login). Upstream grátis (MET Norway, sem
    // chave): o teto protege o fair-use dele, não fatura. Acerto de cache (30 min
    // por geohash de ~5 km) não consome balde. Id 1030 de propósito: fora da
    // sequência 1022+ que outras rotas da Onda 2 podem estar pegando em paralelo
    // — dois bindings com o mesmo namespace_id DIVIDIRIAM o mesmo contador.
    { "name": "CLIMA_RL", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } }
  ]
}
