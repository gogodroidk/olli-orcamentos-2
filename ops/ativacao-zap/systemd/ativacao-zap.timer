[Unit]
Description=Olha a fila de ativação da OLLI (seg–sáb, 9h–18h). O script decide se manda.

[Timer]
# A cada minuto na janela. O script não manda de noite, no domingo, nem fora do teto.
OnCalendar=Mon..Sat 09..17:*:00
AccuracySec=30s
Persistent=false
Unit=ativacao-zap.service

[Install]
WantedBy=timers.target
