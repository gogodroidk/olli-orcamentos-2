[Unit]
Description=Ligar pro Salomao: chamada de voz ao vivo (Gemini Live) - pagina em 127.0.0.1:8796/ligar/ (CQ-LIGAR-SALOMAO)
After=network-online.target

[Service]
WorkingDirectory=/home/igor/wt/cq-ligar-salomao/ops/ligar-salomao
Environment=PATH=/home/igor/.nvm/versions/node/v24.22.1/bin:/home/igor/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LIGAR_PORTA=8796
ExecStart=/home/igor/.nvm/versions/node/v24.22.1/bin/node server.mjs
Restart=on-failure
RestartSec=5
MemoryMax=200M
NoNewPrivileges=yes
PrivateTmp=no

[Install]
WantedBy=default.target
