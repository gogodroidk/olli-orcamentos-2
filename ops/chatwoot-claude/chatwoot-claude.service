[Unit]
Description=Chatwoot + Claude (modo sombra): sugestão em nota privada a cada mensagem de cliente
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/igor/chatwoot-central/chatwoot-claude
ExecStart=/home/igor/.nvm/versions/node/v24.22.1/bin/node /home/igor/chatwoot-central/chatwoot-claude/servico.mjs
Environment=PATH=/home/igor/.local/bin:/home/igor/.nvm/versions/node/v24.22.1/bin:/usr/local/bin:/usr/bin:/bin
# Mesmo endereço do acordador: é por ele que o contêiner do Chatwoot alcança o PC.
Environment=CWC_HOST=172.20.0.1
Environment=CWC_PORTA=3025
Restart=on-failure
RestartSec=10
MemoryMax=200M

[Install]
WantedBy=default.target
