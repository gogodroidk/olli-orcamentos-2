---
/**
 * "Veja como fica" — um item de orçamento REAL do ofício, calculado no build.
 *
 * Nada aqui é escrito à mão e nenhum valor em R$ é inventado: o item vem de `calcular()` da
 * primeira calculadora do ofício que consegue rodar só com os valores de partida da própria
 * ferramenta (`default` do campo, ou o número do `placeholder` "Ex.: 5500"). Se nenhuma
 * calculadora fecha sozinha, o bloco não renderiza (estado vazio assumido: some, não mente).
 * Adicionar ou mudar uma calculadora no app muda este exemplo sozinho.
 */
import type { CalculoOficio } from "../../../src/services/calculosOficio";

interface Props {
	calculos: CalculoOficio[];
	profissao: string;
	cadastroUrl: string;
}
const { calculos, profissao, cadastroUrl } = Astro.props;

function valoresDeExemplo(c: CalculoOficio): Record<string, string> | null {
	const v: Record<string, string> = {};
	for (const campo of c.campos) {
		if (campo.default !== undefined) {
			v[campo.key] = campo.default;
			continue;
		}
		const n = campo.placeholder?.match(/Ex\.?:?\s*([\d.,]+)/i)?.[1];
		if (!n) return null;
		v[campo.key] = n;
	}
	return v;
}

let exemplo: { calc: CalculoOficio; entradas: { label: string; valor: string }[]; saida: { label: string; valor: string; destaque?: boolean }[]; item: { nome: string; descricao: string } } | null = null;
for (const c of calculos) {
	const v = valoresDeExemplo(c);
	if (!v) continue;
	try {
		const r = c.calcular(v);
		// Entrada toda zerada (ex.: contagem de pontos de água) gera um exemplo vazio: pula para a próxima ferramenta.
		if (c.campos.filter((k) => k.tipo === "numero").every((k) => !(parseFloat(String(v[k.key]).replace(",", ".")) > 0))) continue;
		if (!r.itemOrcamento || r.linhas.length === 0) continue;
		// Resultado zerado ("0 L/s") não ensina nada: exemplo só com número de verdade na 1ª linha.
		if (/^0(\s|$)/.test(r.linhas[0].valor)) continue;
		const entradas = c.campos.map((campo) => ({
			label: campo.label,
			valor:
				campo.tipo === "opcao"
					? (campo.opcoes?.find((o) => o.v === v[campo.key])?.label ?? v[campo.key])
					: `${v[campo.key]}${campo.sufixo ? ` ${campo.sufixo}` : ""}`,
		}));
		exemplo = { calc: c, entradas, saida: r.linhas.slice(0, 4), item: r.itemOrcamento };
		break;
	} catch {
		continue;
	}
}
---

{exemplo && (
	<section class="mx-auto max-w-4xl px-6 pb-16" aria-labelledby="exemplo-orcamento">
		<h2 id="exemplo-orcamento" class="text-[clamp(1.5rem,3vw,2.1rem)] font-extrabold tracking-tight text-ink">
			Veja como fica no orçamento de {profissao}.
		</h2>
		<p class="mt-3 max-w-2xl text-slate">
			Você preenche a conta de {exemplo.calc.nome.toLowerCase()}; o resultado vira item do orçamento com um toque.
			Exemplo com os valores de partida da própria ferramenta.
		</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-[1fr_auto_1fr] sm:items-stretch">
			<div class="rounded-cartao border border-line bg-white p-6">
				<p class="text-xs font-semibold uppercase tracking-wide text-muted">1. Você informa</p>
				<dl class="mt-3 space-y-2 text-sm">
					{exemplo.entradas.map((e) => (
						<div class="flex justify-between gap-4">
							<dt class="text-slate">{e.label}</dt>
							<dd class="text-right font-semibold text-ink tnum">{e.valor}</dd>
						</div>
					))}
				</dl>
			</div>
			<div class="hidden place-items-center text-brand-fg sm:grid" aria-hidden="true">→</div>
			<div class="rounded-cartao border border-brand/40 bg-white p-6 shadow-lg shadow-brand/10">
				<p class="text-xs font-semibold uppercase tracking-wide text-muted">2. A OLLI calcula e monta o item</p>
				<dl class="mt-3 space-y-2 text-sm">
					{exemplo.saida.map((l) => (
						<div class="flex justify-between gap-4">
							<dt class="text-slate">{l.label}</dt>
							<dd class:list={["text-right tnum", l.destaque ? "font-extrabold text-brand-fg" : "font-semibold text-ink"]}>{l.valor}</dd>
						</div>
					))}
				</dl>
				<div class="mt-4 border-t border-line pt-3">
					<p class="text-xs font-semibold uppercase tracking-wide text-muted">Item no orçamento</p>
					<p class="mt-1 font-bold text-ink">{exemplo.item.nome}</p>
					<p class="text-sm text-slate">{exemplo.item.descricao}</p>
				</div>
			</div>
		</div>

		<p class="mt-5 text-xs text-muted">{exemplo.calc.base}</p>
		<a
			href={cadastroUrl}
			class="mt-6 inline-block rounded-acao bg-brand px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-strong"
			>Fazer o meu agora — grátis</a
		>
	</section>
)}
