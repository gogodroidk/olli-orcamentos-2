---
interface Props {
	titulo: string;
	texto: string;
	href: string;
	rotulo: string;
}
const { titulo, texto, href, rotulo } = Astro.props;
---

<section class="mx-auto max-w-7xl px-5 pb-20 sm:px-6">
	<div class="rounded-bloco bg-brand-ink px-6 py-14 text-center text-white sm:px-10 sm:py-16">
		<h2 class="mx-auto max-w-2xl text-3xl font-bold leading-tight sm:text-4xl">{titulo}</h2>
		<p class="mx-auto mt-4 max-w-xl text-white/85">{texto}</p>
		<a class="btn btn-claro mt-8" href={href}>{rotulo}</a>
	</div>
</section>
