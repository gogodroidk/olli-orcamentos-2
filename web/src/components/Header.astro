---
/**
 * Cabeçalho do site. A navegação é a mesma em todas as páginas que usam este
 * componente. A página atual leva aria-current. No celular o menu é um
 * <details> nativo: sem script, e o estado base já é o menu fechado.
 *
 * O slot default troca as ações da direita. Sem slot, entram Entrar e Começar grátis.
 */
import OlliLogo from "./OlliLogo.astro";
import { APP_CADASTRO_URL, APP_URL } from "../data/conteudoSite";
import { PAGINAS_HEADER, paginaAtual } from "../data/navegacao";

interface Props {
	class?: string;
}
const { class: containerClass = "max-w-7xl" } = Astro.props;
const path = Astro.url.pathname;
const temAcoes = Astro.slots.has("default");
---

<a href="#conteudo" class="pular">Pular para o conteúdo</a>
<header class="sticky top-0 z-50 border-b border-line/70 bg-card/85 backdrop-blur-lg">
	<nav class={`site-header mx-auto flex ${containerClass} items-center justify-between gap-3 px-4 py-3 sm:px-6`} aria-label="Seções">
		<a href="/" aria-label="OLLI — início" class="inline-flex min-h-11 shrink-0 items-center"><OlliLogo /></a>

		<ul class="hidden items-center gap-0.5 xl:flex">
			{PAGINAS_HEADER.map((item) => (
				<li>
					<a
						href={item.href}
						class="nav-link"
						aria-current={paginaAtual(path, item.href) ? "page" : undefined}
					>{item.rotulo}</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-2">
			<details class="menu-site xl:hidden">
				<summary>Menu</summary>
				<div class="menu-painel">
					<ul>
						{[...PAGINAS_HEADER, { href: "/sobre/", rotulo: "Sobre" }, { href: "/perguntas/", rotulo: "Perguntas" }, { href: "/ajuda/", rotulo: "Ajuda" }].map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={paginaAtual(path, item.href) ? "page" : undefined}
								>{item.rotulo}</a>
							</li>
						))}
					</ul>
				</div>
			</details>

			{temAcoes ? (
				<slot />
			) : (
				<>
					<a href={APP_URL} class="btn btn-header btn-fantasma hidden sm:inline-flex">Entrar</a>
					<a href={APP_CADASTRO_URL} class="btn btn-header btn-primario">Começar grátis</a>
				</>
			)}
		</div>
	</nav>
</header>
