---
/**
 * Rodapé do site. A variante minimal fica nas páginas de anúncio e onde o
 * visitante ainda não deve ver o mapa inteiro no meio da decisão — mesmo assim
 * ela leva as páginas principais e os links legais.
 */
import {
	EMPRESA,
	emailContatoPublicavel,
	identidadePublicavel,
} from "../data/empresa";
import { OFICIOS, SLUG_POR_OFICIO } from "../data/oficios";
import { PAGINAS_EMPRESA, PAGINAS_HEADER } from "../data/navegacao";
import { APP_URL } from "../data/conteudoSite";
import OlliLogo from "./OlliLogo.astro";

interface Props {
	variante?: "completo" | "minimal";
	class?: string;
}
const { variante = "completo", class: containerClass = "max-w-7xl" } = Astro.props;

const ano = new Date().getFullYear();
const CONSULTA_CNPJ =
	"https://solucoes.receita.fazenda.gov.br/Servicos/cnpjreva/Cnpjreva_Solicitacao.asp";

const empresa = identidadePublicavel();
const emailContato = emailContatoPublicavel();
const whatsappUrl = `https://wa.me/${EMPRESA.whatsapp}`;
const CLASSE_LEGAL = "text-slate";
---

<footer class="border-t border-line bg-paper">
	<div class={`mx-auto ${containerClass} px-5 py-12 sm:px-6`}>
		{variante === "completo" ? (
			<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
				<div>
					<a href="/" aria-label="OLLI — início" class="inline-flex min-h-11 items-center"><OlliLogo size={32} /></a>
					<p class="mt-3 max-w-xs text-sm leading-relaxed text-slate">
						Orçamento, ordem de serviço e recibo para quem trabalha com serviço, no celular e no computador.
					</p>
				</div>
				<nav aria-label="Produto">
					<p class="text-xs font-bold uppercase tracking-[0.12em] text-muted">Produto</p>
					<ul class="mt-3 space-y-1">
						{PAGINAS_HEADER.map((item) => (
							<li><a class="rodape-link" href={item.href}>{item.rotulo}</a></li>
						))}
					</ul>
				</nav>
				<nav aria-label="Empresa">
					<p class="text-xs font-bold uppercase tracking-[0.12em] text-muted">Empresa</p>
					<ul class="mt-3 space-y-1">
						{PAGINAS_EMPRESA.map((item) => (
							<li><a class="rodape-link" href={item.href}>{item.rotulo}</a></li>
						))}
						<li><a class="rodape-link" href={APP_URL}>Entrar</a></li>
					</ul>
				</nav>
				<nav aria-label="OLLI por ofício">
					<p class="text-xs font-bold uppercase tracking-[0.12em] text-muted">Ofícios</p>
					<ul class="mt-3 space-y-1">
						{OFICIOS.map((o) => (
							<li><a class="rodape-link" href={`/para/${SLUG_POR_OFICIO[o.id]}/`}>{o.label}</a></li>
						))}
					</ul>
				</nav>
			</div>
		) : (
			<nav aria-label="Páginas" class="flex flex-wrap gap-x-5 gap-y-2">
				{PAGINAS_HEADER.map((item) => (
					<a class="rodape-link" href={item.href}>{item.rotulo}</a>
				))}
				<a class="rodape-link" href="/sobre/">Sobre</a>
				<a class="rodape-link" href="/perguntas/">Perguntas</a>
			</nav>
		)}

		<div class={`mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-6 text-sm ${CLASSE_LEGAL}`}>
			<a class="rodape-link" href="/legal/privacidade/">Privacidade</a>
			<a class="rodape-link" href="/legal/termos/">Termos</a>
			<a class="rodape-link" href="/excluir-conta/">Excluir conta</a>
			<a class="rodape-link" href="/ajuda/">Ajuda</a>
			<p class="text-sm text-muted">© {ano} OLLI Orçamentos</p>
		</div>

		{empresa && (
			<address class={`mt-4 text-xs not-italic leading-relaxed ${CLASSE_LEGAL}`}>
				<span class="font-semibold">{empresa.razaoSocial}</span>
				<span> · CNPJ {empresa.cnpj}</span>
				<span> · </span>
				<a href={CONSULTA_CNPJ} target="_blank" rel="noopener noreferrer" class="rodape-link underline-offset-2 hover:underline">Conferir na Receita Federal</a>
				<br />
				<a href={whatsappUrl} class="rodape-link">WhatsApp {EMPRESA.whatsappLegivel}</a>
				{emailContato && (
					<>
						<span> · </span>
						<a href={`mailto:${emailContato}`} class="rodape-link">{emailContato}</a>
					</>
				)}
			</address>
		)}
	</div>
</footer>
