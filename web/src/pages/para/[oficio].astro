---
/**
 * /para/[oficio] — as páginas de ofício (LANDING_BRIEF, arquitetura hub-and-spoke).
 *
 * É AQUI que mora o SEO: quem procura digita "app para eletricista", não "sistema de
 * field service". A home é genérica de propósito; estas páginas são específicas.
 *
 * TEMPLATE ÚNICO, CONTEÚDO DA FONTE: as rotas saem de `VERTICAIS` (o mesmo catálogo
 * do app) e as calculadoras vêm de `calculosDoOficio()` — a MESMA função de gate que
 * a tela do app usa. Cada calculadora traz `nome`, `descricao` e `base` (a norma:
 * "NBR 5410 §6.2.5", "NBR 5626"…), que é conteúdo técnico real, não texto de venda.
 * Ninguém escreveu essas linhas para o site: elas são o produto se descrevendo.
 *
 * Consequência: adicionar uma calculadora ao app publica conteúdo novo aqui sozinho.
 * E não há como esta página prometer uma ferramenta que o app não tem.
 *
 * Os ofícios do briefing que NÃO existem em `verticais.ts` (montador de móveis,
 * marido de aluguel) NÃO viram página: página de SEO para um ofício sem ferramenta
 * seria exatamente a promessa vazia que a regra da casa proíbe.
 */
import FaqSite from "../../components/site/FaqSite.astro";
import LayoutSite from "../../layouts/LayoutSite.astro";
import { AVISO_ILUSTRATIVA, FOTOS, FOTO_POR_ALIAS, FOTO_POR_OFICIO } from "../../data/fotos";
import { SEGMENTOS_SITE } from "../../data/segmentos-site";
import { FRASE_PIX_LINK, GRATIS_ORC, GRATIS_SEM, PROFISSAO_NOVA, ROTA, SEGMENTOS_NOVOS, SERVICOS_FORA_DO_MENU, SERVICOS_MENU, URL_CADASTRO } from "../../data/site";
import { calculosDoOficio } from "../../../../src/services/calculosOficio";
import { VERTICAIS, VERTICAL_GERAL } from "../../../../src/services/verticais";
import {
	DOR_POR_OFICIO,
	ICONE_POR_OFICIO,
	OFICIOS,
	OFICIO_GERAL,
	PROFISSAO_POR_OFICIO,
	OG_PROPRIO_POR_SLUG,
	SLUG_POR_OFICIO,
	ALIASES_PARA,
} from "../../data/oficios";
// Preço só da FONTE (Stripe live) — sem literal de R$ nas FAQs desta página.
import { PRECO_EMPRESA, PRECO_PRO, reais } from "../../data/planos";
import { FRASE_GRATIS_CURTA, GRATIS_CONDICAO, recursosQueSairamDoGratis, TEXTO_SELO_OLLI } from "../../data/recursos";
import { postsPublicados } from "../blog/_dados";
import { TRIAL_PRO_DIAS } from "../../../../src/services/limitesComerciais";

const APP_URL = "https://app.olliorcamentos.online";
// CC-01: todos os CTAs desta página são de CADASTRO — abrem a conta direto
// (o painel lê ?modo=cadastro) em vez de cair na tela de login.
const APP_CADASTRO_URL = `${APP_URL}/auth/login?modo=cadastro`;

/**
 * MDI → ícone lucide (componente `<Icone nome={...} />`). `calculosDoOficio()`
 * devolve `icon` no vocabulário do APP (MaterialCommunityIcons do React
 * Native: "flash", "water-outline"…). A web não tem essa fonte, então
 * renderizar `{c.icon}` cru imprimia a palavra `flash` em inglês, em corpo
 * 24px, nos 21 cards das 6 páginas — justo as que recebem anúncio.
 *
 * Era emoji (mapa `EMOJI_POR_ICONE`); virou lucide pra casar com o resto da
 * identidade — landing e painel (lucide-react) com o MESMO traço, não um
 * mosaico de glifos de fonte de cada sistema operacional.
 *
 * O fallback é "" DE PROPÓSITO (ver `Icone.astro`: nome desconhecido = svg
 * vazio): calculadora nova no app não pode voltar a vazar identificador cru
 * pra produção. Some o enfeite, fica o título — degradação silenciosa é
 * melhor que texto errado.
 */
const ICONE_POR_MDI: Record<string, string> = {
	"air-conditioner": "wind",
	fence: "fence",
	flash: "zap",
	"flask-outline": "flask-conical",
	"format-paint": "paint-roller",
	fuse: "power", // sem ícone lucide de disjuntor — "power" é o mais próximo
	"gas-cylinder": "cylinder", // sem "botijão" em lucide — cilindro é o mais próximo
	gauge: "gauge",
	grass: "leaf",
	pipe: "cable", // sem "tubo/eletroduto" em lucide — conduíte é o mais próximo
	shovel: "shovel",
	"sine-wave": "activity",
	sprout: "sprout",
	thermometer: "thermometer",
	"timer-sand": "hourglass",
	wall: "brick-wall",
	"water-outline": "droplet",
	"water-percent": "droplets",
	"water-well": "database", // sem "poço/fossa" em lucide — reservatório é o mais próximo
};

export function getStaticPaths() {
	return [
		...[...VERTICAIS, VERTICAL_GERAL].map((v) => ({
			params: { oficio: SLUG_POR_OFICIO[v.id] },
			props: { id: v.id, alias: null, segmento: null },
		})),
		// Variantes de anúncio por palavra (D-1013): mesma vertical, canonical na página de SEO, fora do sitemap.
		...ALIASES_PARA.map((a) => ({
			params: { oficio: a.slug },
			props: { id: a.id, alias: a, segmento: null },
		})),
		// Segmentos que só existem na v10 (D-2876): o texto vem de data/segmentos-site.ts; o ofício-base é o "geral".
		...SEGMENTOS_NOVOS.map((slug) => ({
			params: { oficio: slug },
			props: { id: "geral" as const, alias: null, segmento: slug },
		})),
	];
}

const { id, alias, segmento } = Astro.props;
const oficio = id === "geral" ? OFICIO_GERAL : OFICIOS.find((o) => o.id === id)!;
const profissao = (segmento && PROFISSAO_NOVA[segmento]) || alias?.profissao || PROFISSAO_POR_OFICIO[id];
const dor = DOR_POR_OFICIO[id];
const calculos = calculosDoOficio(id);
// Foto só onde combina com o ofício da página (ver data/fotos.ts); página sem foto fica como está.
const fotoChave = (alias && FOTO_POR_ALIAS[alias.slug]) || FOTO_POR_OFICIO[id];

/**
 * "Leia também": os posts publicados DESTE ofício (campo `oficio` do front-matter, validado contra
 * VERTICAIS) — a ponte inversa à que `blog/[slug].astro` já faz (post → página do ofício). Nenhuma lista
 * escrita à mão: post novo marcado com o ofício aparece aqui sozinho, rascunho nunca aparece (`postsPublicados`).
 * Posts do próprio ofício primeiro; os `oficio: 'todos'` (que o schema manda aparecer em TODAS as páginas) completam até 3.
 * Sem post, o bloco some (não renderiza título vazio).
 */
const todosPosts = await postsPublicados();
const leiaTambem = [
	...todosPosts.filter((p) => p.data.oficio === id),
	...todosPosts.filter((p) => p.data.oficio === "todos"),
].slice(0, 3);

const titulo = `App de orçamento e ordem de serviço para ${profissao} — OLLI`;
const slug = segmento ?? SLUG_POR_OFICIO[id];
// marido-de-aluguel deixa de ser alias na v10: página própria, canonical próprio, no sitemap.
const chaveSite = segmento ?? (alias && SEGMENTOS_SITE[alias.slug] && alias.slug === "marido-de-aluguel" ? alias.slug : slug);
const seg = SEGMENTOS_SITE[chaveSite] ?? null;
const nomeMenu = [...SERVICOS_MENU, ...SERVICOS_FORA_DO_MENU].find((m) => m.slug === chaveSite)?.nome ?? oficio.label;
const canonicalPath = alias && alias.slug !== "marido-de-aluguel" ? `/para/${slug}/` : undefined;
const ogImagem = !segmento && OG_PROPRIO_POR_SLUG.has(slug) ? `/og/${slug}.png` : undefined;
/**
 * A meta description do ofício "qualquer serviço" dizia "com 0 calculadora de campo"
 * — o Google mostrava isso no resultado. Sem calculadora, a frase fala do ciclo, que
 * é o que a página entrega; com calculadora, o número continua vindo da fonte.
 */
// Meta description ≤160 caracteres (o Google corta ali; auditoria 20/11 item a5): o ofício, o link de aprovação e o Grátis.
const descricao = `Orçamento para ${profissao} no celular, com link para o cliente aprovar. Grátis, sem cartão.`;

/**
 * BreadcrumbList — o brief pede nas subpáginas. Ajuda o Google a entender a
 * hierarquia (home → ofício) e rende o caminho no resultado de busca.
 */
const schemaBreadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "OLLI", item: Astro.site?.origin },
		{ "@type": "ListItem", position: 2, name: oficio.label, item: Astro.url.href },
	],
};

const WHATSAPP_URL = "https://wa.me/5511941727487";
const waMsg = encodeURIComponent(`Oi! Sou ${profissao} e quero saber como a OLLI funciona pro meu ofício.`);

/**
 * FAQ POR OFÍCIO (ST-07 / AEO-1 / BC-05) — antes só o index tinha FAQ + FAQPage.
 * As 6 páginas de ofício, que são o destino do anúncio e onde a IA busca resposta
 * ("existe app de orçamento grátis pra eletricista?"), não tinham nenhuma.
 *
 * Geradas DA FONTE, não escritas à mão por ofício: profissão, contagem e nomes das
 * calculadoras, dor e preços saem dos dados que a página já usa. Adicionar uma
 * calculadora ao app muda a resposta aqui sozinho — a regra da casa (copy derivada
 * da fonte) aplicada à FAQ. A #2 só entra se o ofício tem calculadora.
 */
const nomesCalc = calculos.map((c) => c.nome).join(", ");

/**
 * "Resposta curta" (40–60 palavras): o parágrafo que o buscador de IA pode citar inteiro. Fica no topo do
 * HTML, logo após o H1. Só fatos da fonte: profissão, contagem de calculadoras e a regra do Grátis (FRASE_GRATIS_CURTA, que
 * já carrega a regra vigente) vêm dos mesmos dados do resto da página; nada de "permanente"/"sem cartão"
 * escrito à mão (CDC: se o limite do Grátis ligar, o texto acompanha); nenhum preço (P0) e nada que o app não faça. Se um dado da
 * fonte mudar e o texto sair do intervalo, o build FALHA em vez de publicar uma resposta torta.
 */
const calcTrecho =
	calculos.length > 0
		? ` com ${calculos.length} calculadora${calculos.length > 1 ? "s" : ""} de campo`
		: "";
const montaResposta = (comSelo: boolean) =>
	`A OLLI é um app de orçamento, ordem de serviço e recibo para ${profissao}, no celular ou no computador. No plano Grátis, ${GRATIS_CONDICAO}: ${FRASE_GRATIS_CURTA}${comSelo ? `, com o selo discreto "${TEXTO_SELO_OLLI}"` : ""}. Para começar, crie a conta, monte o primeiro orçamento${calcTrecho} e envie o link para o cliente aprovar.`;
const contaPalavras = (t: string) => t.split(/\s+/).length;
/**
 * Alvo: 40–60 palavras. Se o corte do Grátis ligar, FRASE_GRATIS_CURTA passa a carregar o limite (data e número)
 * e o texto cresce: primeiro tira o selo (ele continua em FAQ e no cartão do plano), e só então aceita até 75,
 * porque o limite dito com honestidade vale mais que o tamanho. Fora de 40–75 o build falha.
 */
let respostaCurta = montaResposta(true);
if (contaPalavras(respostaCurta) > 60) respostaCurta = montaResposta(false);
const palavrasResposta = contaPalavras(respostaCurta);
if (palavrasResposta < 40 || palavrasResposta > 75) {
	throw new Error(`/para/${slug}: "Resposta curta" com ${palavrasResposta} palavras (esperado 40–60, teto 75 com o limite do Grátis): ${respostaCurta}`);
}
const faqs = [
	{
		q: `Existe app de orçamento grátis para ${profissao}?`,
		a: `Sim. A OLLI tem um plano Grátis, ${GRATIS_CONDICAO}, com orçamento, clientes e histórico; ${recursosQueSairamDoGratis()} são do Pro. O que cada plano inclui hoje está na página de planos. Depois do primeiro envio, há ${TRIAL_PRO_DIAS} dias opcionais de Pro sem cartão e sem cobrança automática.`,
	},
	...(calculos.length > 0
		? [
				{
					q: `Quais calculadoras a OLLI tem para ${profissao}?`,
					a: `${calculos.length} calculadora${calculos.length > 1 ? "s" : ""} de campo, cada uma com a norma ou a fórmula daquele ofício e com o resultado virando item do orçamento: ${nomesCalc}.`,
				},
			]
		: []),
	// Uma pergunta por calculadora (até 3): é como o prestador pergunta à IA ("como dimensionar disjuntor?").
	// A resposta é a descrição e a base técnica da própria ferramenta — nada escrito à mão por ofício.
	...calculos.slice(0, 3).map((c) => ({
		q: `Como fazer a conta de ${c.nome.replace(/^calculadora de /i, "").toLowerCase()} no orçamento de ${profissao}?`,
		a: `${c.descricao} Base técnica: ${c.base} Na OLLI você preenche os campos e o resultado vira item do orçamento com um toque.`,
	})),
	{
		q: `A OLLI serve pra ${profissao} autônomo?`,
		a: `Serve. É feita pro prestador que fecha e executa o serviço sozinho: orçamento no celular, link pro cliente aprovar e recibo no fim. O plano Pro é ${reais(PRECO_PRO.mensalCentavos)}/mês. O plano Empresa (${reais(PRECO_EMPRESA.mensalCentavos)}/mês), com equipe e permissões, entra só quando você tem uma equipe.`,
	},
	{
		q: `Precisa instalar alguma coisa pra usar como ${profissao}?`,
		a: `Não. A OLLI roda no navegador do celular e do computador — você entra e já começa, sem instalar app nem configurar nada.`,
	},
];

/**
 * FAQPage serializado do MESMO array `faqs` que a tela renderiza — schema que
 * diverge do texto visível é conteúdo enganoso pro Google. Gerar do array garante
 * que não podem divergir.
 */
const schemaFaq = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<LayoutSite titulo={titulo} descricao={descricao} schemas={[schemaBreadcrumb, schemaFaq]} ogImagem={ogImagem} canonicalPath={canonicalPath}>
	<section class="page-hero">
		<div class={`w ${fotoChave ? "hero-seg" : ""}`}>
			<div>
				<p class="crumbs"><a href={ROTA.inicio}>Início</a> · <a href={ROTA.tecnicos}>Para técnicos</a> · {nomeMenu}</p>
				{seg ? (
					<h1>{seg.h1a} <em>{seg.h1b}</em></h1>
				) : (
					<h1>Orçamento de {profissao} <em>com a sua marca.</em></h1>
				)}
				<p class="lead">{seg ? seg.lead : dor}</p>
				<div class="cta">
					<a class="bt p" href={URL_CADASTRO}>Começar grátis →</a>
					<a class="bt s" href={ROTA.planos}>Ver planos</a>
				</div>
			</div>
			{fotoChave && (
				<figure class="seg-foto">
					<img
						src={`/fotos/tecnico-${fotoChave}-896.webp`}
						srcset={`/fotos/tecnico-${fotoChave}-448.webp 448w, /fotos/tecnico-${fotoChave}-896.webp 896w`}
						sizes="(min-width: 900px) 280px, 70vw"
						width="896"
						height="1200"
						alt={FOTOS[fotoChave].alt}
						loading="eager"
						decoding="async"
					/>
					<figcaption>{AVISO_ILUSTRATIVA}</figcaption>
				</figure>
			)}
		</div>
	</section>

	<section aria-labelledby="resposta-curta">
		<div class="w">
			<div class="resposta-curta gl">
				<p class="section-kicker" id="resposta-curta">Em poucas palavras</p>
				<p>{respostaCurta}</p>
			</div>
		</div>
	</section>

	{seg && (
		<section aria-labelledby="servicos-segmento">
			<div class="w">
				<div class="seg-grid">
					<div>
						<p class="section-kicker">{seg.kicker}</p>
						<h2 id="servicos-segmento">{seg.listaTitulo}</h2>
						<ul class="checklist">{seg.itens.map((i) => <li>{i}</li>)}</ul>
					</div>
					{seg.tela && (
						<figure class="seg-tela">
							<div class="phone-mini">
								<div class="device device-iphone-14-pro">
									<div class="device-frame">
										<img class="device-screen" src={`/site/app/telas/${seg.tela.arquivo}.webp`} srcset={`/site/app/telas/${seg.tela.arquivo}.webp 1x, /site/app/telas/${seg.tela.arquivo}@2x.webp 2x`} alt={seg.tela.alt} width="390" height="844" loading="lazy" decoding="async" />
									</div>
									<div class="device-header"></div><div class="device-sensors"></div><div class="device-btns"></div><div class="device-power"></div>
								</div>
							</div>
							<figcaption>Dados de exemplo</figcaption>
						</figure>
					)}
				</div>
			</div>
		</section>
	)}

	{calculos.length > 0 && (
		<section aria-labelledby="calculadoras-oficio">
			<div class="w">
				<p class="section-kicker">Ferramentas do ofício</p>
				<h2 id="calculadoras-oficio">Contas de {profissao}, direto no orçamento.</h2>
				<ul class="checklist">
					{calculos.map((c) => <li><strong>{c.nome}.</strong> {c.descricao}</li>)}
				</ul>
			</div>
		</section>
	)}

	{seg && (
		<section aria-labelledby="ajuda-segmento">
			<div class="w">
				<p class="section-kicker">{seg.ajudaKicker}</p>
				<h2 id="ajuda-segmento">{seg.ajudaTitulo}</h2>
				<div class="bento">
					{seg.cards.map((c) => {
						const texto = c.p.replace("@PIX@", FRASE_PIX_LINK).trim();
						return <div class="gl"><h3>{c.h}</h3><p>{texto}</p></div>;
					})}
				</div>
			</div>
		</section>
	)}

	<section aria-labelledby="faq-oficio">
		<div class="w">
			<p class="section-kicker">Antes de começar</p>
			<h2 id="faq-oficio">Perguntas de quem trabalha com {profissao}.</h2>
			<FaqSite itens={faqs.map((f, i) => ({ id: `f${i}`, q: f.q, a: f.a }))} abrirPrimeiro />
		</div>
	</section>

	{leiaTambem.length > 0 && (
		<section aria-labelledby="leia-tambem">
			<div class="w">
				<h2 id="leia-tambem">Leia também</h2>
				<div class="bento">
					{leiaTambem.map((p) => (
						<div class="gl"><h3><a href={`/blog/${p.id}/`}>{p.data.titulo}</a></h3><p>{p.data.descricao}</p></div>
					))}
				</div>
			</div>
		</section>
	)}

	<section class="segment-directory" aria-labelledby="outros-segmentos">
		<div class="w">
			<h2 id="outros-segmentos">O OLLI para outros serviços</h2>
			<div class="segment-links">
				{[...SERVICOS_MENU, ...SERVICOS_FORA_DO_MENU].map((m) => (
					<a href={`/para/${m.slug}/`} aria-current={m.slug === chaveSite ? "page" : undefined}>{m.nome}</a>
				))}
			</div>
		</div>
	</section>

	<section>
		<div class="w">
			<div class="fin gl">
				<h2>{seg ? seg.final : `Seu próximo orçamento de ${profissao} sai com a sua marca.`}</h2>
				<p class="sub">O plano Grátis permite {GRATIS_ORC}, {GRATIS_SEM}.</p>
				<div class="cta">
					<a class="bt p" href={URL_CADASTRO}>Começar grátis →</a>
					<a class="bt s" href={ROTA.recursos}>Conhecer os recursos</a>
				</div>
			</div>
		</div>
	</section>
</LayoutSite>
