---
/**
 * /para/ — o hub das profissões. Existia /para/<ofício>/ para cada um dos 10,
 * mas nada ligava as dez entre si: o rastreador (e a IA que monta resposta de
 * "app de orçamento para <profissão>") não tinha uma página que dissesse, num
 * lugar só, para quem a OLLI serve e o que cada ofício tem pronto.
 *
 * 100% derivado da fonte: a lista vem de `OFICIOS`/`OFICIO_GERAL`, as contagens de
 * `calculosDoOficio` (via `calculadoras`) e os documentos de `FERRAMENTAS` com
 * `disponivel: true`. Vertical nova entra aqui sozinha; promessa não entra.
 */
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Icone from "../../components/Icone.astro";
import Layout from "../../layouts/Layout.astro";
import {
	DOR_POR_OFICIO,
	ICONE_POR_OFICIO,
	OFICIOS,
	OFICIO_GERAL,
	PROFISSAO_POR_OFICIO,
	SLUG_POR_OFICIO,
} from "../../data/oficios";

const APP_CADASTRO_URL = "https://app.olliorcamentos.online/auth/login?modo=cadastro";
const ORIGEM = Astro.site?.origin ?? "https://olliorcamentos.online";

const todos = [...OFICIOS, OFICIO_GERAL];

const titulo = "App de orçamento por profissão — OLLI";
const descricao =
	"Orçamento, ordem de serviço e recibo para climatização, elétrica, hidráulica, pintura, dedetização, caixa d'água, piscina, extintores e jardinagem. Veja o que a OLLI tem pronto para o seu ofício.";

const schemaBreadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "OLLI", item: `${ORIGEM}/` },
		{ "@type": "ListItem", position: 2, name: "Por profissão", item: `${ORIGEM}/para/` },
	],
};

/** A lista que a IA lê: cada profissão com a URL e a linha que a descreve. */
const schemaLista = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: titulo,
	description: descricao,
	url: `${ORIGEM}/para/`,
	mainEntity: {
		"@type": "ItemList",
		itemListElement: todos.map((o, i) => ({
			"@type": "ListItem",
			position: i + 1,
			name: `OLLI para ${PROFISSAO_POR_OFICIO[o.id]}`,
			url: `${ORIGEM}/para/${SLUG_POR_OFICIO[o.id]}/`,
		})),
	},
};
---

<Layout titulo={titulo} descricao={descricao} schemas={[schemaBreadcrumb, schemaLista]}>
	<Header />

	<main id="conteudo">
		<section class="mx-auto max-w-4xl px-6 pb-10 pt-14">
			<nav aria-label="Você está aqui" class="text-sm text-muted">
				<a href="/" class="inline-flex min-h-11 min-w-11 items-center justify-center hover:text-brand-fg">Início</a>
				<span aria-hidden="true" class="mx-1.5">/</span>
				<span class="text-slate">Por profissão</span>
			</nav>
			<h1 class="mt-6 text-[clamp(2.1rem,5vw,3.4rem)] font-extrabold leading-[1.05] tracking-tight text-ink">
				App de orçamento para a <span class="brand-text">sua profissão</span>.
			</h1>
			<p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate">
				A OLLI monta o orçamento, o cliente aprova por um link, e a ordem de serviço e o recibo saem do mesmo
				documento. Em cada ofício, o que muda são as ferramentas que ficam dentro do orçamento. Escolha o seu e veja
				o que já está pronto, sem promessa.
			</p>
		</section>

		<section class="mx-auto max-w-4xl px-6 pb-20">
			<ul class="grid gap-4 sm:grid-cols-2">
				{todos.map((o) => (
					<li>
						<a
							href={`/para/${SLUG_POR_OFICIO[o.id]}/`}
							class="block h-full rounded-cartao border border-line bg-card p-6 transition hover:border-brand"
						>
							<div class="grid h-11 w-11 place-items-center rounded-acao bg-tint text-brand-fg">
								<Icone nome={ICONE_POR_OFICIO[o.id]} class="h-5 w-5" />
							</div>
							<h2 class="mt-3 text-lg font-bold text-ink">OLLI para {PROFISSAO_POR_OFICIO[o.id]}</h2>
							<p class="mt-1.5 text-sm leading-relaxed text-slate">{DOR_POR_OFICIO[o.id]}</p>
							<p class="mt-3 border-t border-line pt-3 text-xs leading-relaxed text-muted">{o.tagline}</p>
						</a>
					</li>
				))}
			</ul>

			<div class="mt-10 flex flex-col gap-3 sm:flex-row">
				<a
					href={APP_CADASTRO_URL}
					class="rounded-acao bg-brand px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-strong"
					>Criar meu primeiro orçamento — grátis</a
				>
				<a
					href="/blog/"
					class="rounded-acao border border-line bg-card px-7 py-3.5 text-center text-base font-semibold text-ink transition hover:border-brand hover:text-brand-fg"
					>Guias do blog</a
				>
			</div>
		</section>
	</main>

	<Footer variante="minimal" />
</Layout>
