---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HeroDevices from "../components/HeroDevices.tsx";
import Icone from "../components/Icone.astro";
import FaixaCta from "../components/site/FaixaCta.astro";
import ListaFaq from "../components/site/ListaFaq.astro";
import Layout from "../layouts/Layout.astro";
import { postsPublicados } from "./blog/_dados";
import {
	APP_CADASTRO_URL,
	PASSOS,
	faqProduto,
} from "../data/conteudoSite";
import {
	ICONE_POR_OFICIO,
	OFICIOS,
	OFICIO_GERAL,
	SLUG_POR_OFICIO,
	TOTAL_CALCULADORAS,
} from "../data/oficios";
import { DESCONTO_ANUAL_ROTULO, PRECO_EMPRESA, PRECO_PRO, reais } from "../data/planos";

const faq = faqProduto();
const posts = (await postsPublicados()).slice(0, 3);
const precos = [
	{ nome: "Grátis", valor: reais(0), nota: "sem prazo" },
	{ nome: "Pro", valor: reais(PRECO_PRO.mensalCentavos), nota: "por mês" },
	{ nome: "Empresa", valor: reais(PRECO_EMPRESA.mensalCentavos), nota: "por mês" },
];
---

<Layout
	titulo="App de Orçamento e Ordem de Serviço para Prestador | OLLI"
	descricao="Crie orçamentos profissionais no celular ou computador, personalize com a sua marca e envie um link para o cliente aprovar. Grátis para começar, sem cartão."
>
	<Header />

	<main id="conteudo">
		<section class="relative overflow-clip">
			<div class="pointer-events-none absolute inset-0 -z-10">
				<div class="absolute -right-40 -top-40 h-[38rem] w-[38rem] rounded-full opacity-60 blur-3xl" style="background: radial-gradient(closest-side, rgba(63,216,234,.28), transparent)"></div>
				<div class="absolute -left-40 top-40 h-[34rem] w-[34rem] rounded-full opacity-50 blur-3xl" style="background: radial-gradient(closest-side, rgba(11,111,206,.20), transparent)"></div>
			</div>

			<div class="mx-auto grid max-w-7xl items-center gap-10 px-5 pb-16 pt-10 sm:px-6 md:gap-14 md:pb-24 md:pt-16 lg:grid-cols-[1.05fr_1fr] lg:pt-20">
				<div class="min-w-0">
					<span class="eyebrow"><span aria-hidden="true">●</span> Plataforma de orçamentos para qualquer negócio de serviço</span>
					<h1 class="mt-4 max-w-[42rem] text-4xl leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
						Troque o orçamento improvisado no WhatsApp por uma <span class="brand-text">plataforma com a sua marca.</span>
					</h1>
					<p class="mt-5 max-w-[42rem] text-lg leading-relaxed text-slate">
						Crie <strong class="text-ink">orçamentos profissionais em minutos</strong>, personalize com a sua identidade e envie um link para o cliente aprovar — no celular ou computador, seja qual for o serviço que você vende.
					</p>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a href={APP_CADASTRO_URL} class="btn btn-primario w-full sm:w-auto">Criar meu primeiro orçamento — grátis</a>
						<a href="/como-funciona/" class="btn btn-secundario w-full sm:w-auto">Ver como funciona</a>
					</div>
					<ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate">
						<li class="inline-flex items-center gap-1.5"><span class="text-check">✓</span> Sem cartão pra testar</li>
						<li class="inline-flex items-center gap-1.5"><span class="text-check">✓</span> Sem fidelidade</li>
						<li class="inline-flex items-center gap-1.5"><span class="text-check">✓</span> Celular + computador</li>
					</ul>
					<div id="android-em-teste" class="mt-5 max-w-xl rounded-campo border border-line bg-card p-4 shadow-e1">
						<p class="text-sm leading-relaxed text-slate">
							<strong class="text-ink">Aplicativo Android em teste fechado.</strong>
							A instalação pela Google Play está restrita a testadores selecionados. Se a sua conta ainda não foi incluída, use a OLLI pelo navegador. Não há aplicativo para iPhone/iOS nesta versão.
						</p>
						<div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
							<a
								href="https://play.google.com/apps/testing/online.olliorcamentos.app"
								target="_blank"
								rel="noopener noreferrer"
								aria-label="Acessar o teste fechado do OLLI para Android na Google Play (abre em nova guia)"
								class="btn btn-secundario min-h-11 px-4 py-2 text-sm"
							>
								Acessar o teste na Google Play <span class="ms-1" aria-hidden="true">↗</span>
							</a>
							<a href={APP_CADASTRO_URL} class="btn btn-fantasma min-h-11 px-4 py-2 text-sm underline decoration-brand/30 underline-offset-2">Usar pelo navegador</a>
						</div>
					</div>
				</div>
				<div class="olli-hero-deriva min-w-0 lg:ps-6">
					<HeroDevices client:media="(hover: hover) and (pointer: fine)" />
				</div>
			</div>
		</section>

		<section class="faixa-recuo" aria-label="Números do produto">
			<div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-5 py-10 sm:grid-cols-4 sm:px-6">
				{[
					{ k: reais(0), v: "grátis, sem prazo" },
					{ k: String(OFICIOS.length), v: "ofícios atendidos" },
					{ k: String(TOTAL_CALCULADORAS), v: "calculadoras de campo" },
					{ k: "698", v: "códigos de erro (climatização)" },
				].map((s) => (
					<div class="text-center">
						<div class="text-3xl font-bold tracking-tight text-ink tnum">{s.k}</div>
						<div class="mt-1 text-sm text-muted">{s.v}</div>
					</div>
				))}
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
			<div class="max-w-2xl">
				<span class="eyebrow">A empresa</span>
				<h2 class="mt-4 text-3xl tracking-tight text-ink sm:text-4xl">Dois caminhos, o mesmo trabalho de campo.</h2>
				<p class="mt-4 text-lg leading-relaxed text-slate">
					A OLLI Orçamentos monta o documento. O catálogo de serviços guarda a tabela do seu ofício para o orçamento sair no local. Os dois estão no mesmo app.
				</p>
			</div>
			<div class="mt-10 grid gap-5 md:grid-cols-2">
				<a href="/produto/" class="cartao-link rounded-cartao border border-line bg-card p-7 shadow-e1">
					<p class="text-sm font-semibold text-brand-fg">OLLI Orçamentos</p>
					<h3 class="mt-2 text-2xl text-ink">Orçamento, ordem de serviço e recibo.</h3>
					<p class="mt-3 text-slate">PDF com a sua marca, link para o cliente aprovar e as ferramentas do seu ofício dentro do mesmo documento.</p>
					<span class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-brand-fg">Ver o produto</span>
				</a>
				<a href="/catalogo/" class="cartao-link rounded-cartao border border-line bg-card p-7 shadow-e1">
					<p class="text-sm font-semibold text-brand-fg">Serviços e produtos</p>
					<h3 class="mt-2 text-2xl text-ink">A tabela do serviço, pronta para o orçamento.</h3>
					<p class="mt-3 text-slate">Catálogo, agenda, checklist e assinatura na tela. O que o cliente pediu vira OS e recibo sem redigitar.</p>
					<span class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-brand-fg">Ver o catálogo</span>
				</a>
			</div>
		</section>

		<section id="oficios" class="faixa-recuo">
			<div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
				<div class="mx-auto max-w-2xl text-center">
					<span class="eyebrow">Feito pro seu ofício</span>
					<h2 class="mt-4 text-3xl tracking-tight text-ink sm:text-4xl">A OLLI se veste do seu serviço.</h2>
					<p class="mt-5 text-lg leading-relaxed text-slate">
						São <strong class="text-ink">{TOTAL_CALCULADORAS} calculadoras de campo</strong>, cada uma com a norma ou a fórmula daquele ofício — e você só vê as do seu. O resto some da tela.
					</p>
				</div>
				<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{OFICIOS.map((o) => (
						<a href={`/para/${SLUG_POR_OFICIO[o.id]}/`} class="cartao-link rounded-cartao border border-line bg-card p-6 shadow-e1">
							<Icone nome={ICONE_POR_OFICIO[o.id]} class="h-8 w-8" />
							<h3 class="mt-3 text-lg text-ink">{o.label}</h3>
							<p class="mt-1.5 text-sm leading-relaxed text-slate">{o.tagline}</p>
						</a>
					))}
					<a href={`/para/${SLUG_POR_OFICIO[OFICIO_GERAL.id]}/`} class="cartao-link rounded-cartao border border-dashed border-line bg-paper p-6">
						<Icone nome={ICONE_POR_OFICIO[OFICIO_GERAL.id]} class="h-8 w-8" />
						<h3 class="mt-3 text-lg text-ink">{OFICIO_GERAL.label}</h3>
						<p class="mt-1.5 text-sm leading-relaxed text-slate">{OFICIO_GERAL.tagline}</p>
					</a>
				</div>
			</div>
		</section>

		<section id="como" class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div class="max-w-2xl">
					<span class="eyebrow">Como funciona</span>
					<h2 class="mt-4 text-3xl tracking-tight text-ink sm:text-4xl">Três passos. Zero planilha.</h2>
				</div>
				<a href="/como-funciona/" class="rodape-link font-semibold text-brand-fg">Ver o passo a passo</a>
			</div>
			<ol class="mt-10 grid gap-5 md:grid-cols-3">
				{PASSOS.map((p) => (
					<li class="rounded-cartao border border-line bg-card p-6 shadow-e1">
						<div class="text-sm font-bold text-brand-fg tnum">{p.n}</div>
						<h3 class="mt-2 text-xl text-ink">{p.titulo}</h3>
						<p class="mt-2 text-slate">{p.texto}</p>
					</li>
				))}
			</ol>
		</section>

		<section id="planos" class="faixa-recuo">
			<div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
				<div class="mx-auto max-w-2xl text-center">
					<span class="eyebrow">Preços</span>
					<h2 class="mt-4 text-3xl tracking-tight text-ink sm:text-4xl">Comece de graça. Pague quando crescer.</h2>
					<p class="mt-4 text-slate">O grátis é sério e sem prazo. No mensal, ou no anual com {DESCONTO_ANUAL_ROTULO} de desconto.</p>
				</div>
				<ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
					{precos.map((p) => (
						<li class="rounded-cartao border border-line bg-card p-6 text-center shadow-e1">
							<p class="text-sm font-semibold text-slate">{p.nome}</p>
							<p class="mt-2 text-3xl font-bold tracking-tight text-ink tnum">{p.valor}</p>
							<p class="mt-1 text-sm text-muted">{p.nota}</p>
						</li>
					))}
				</ul>
				<p class="mt-8 text-center">
					<a href="/planos/" class="rodape-link font-semibold text-brand-fg">Comparar todos os recursos, lado a lado</a>
				</p>
			</div>
		</section>

		<section class="zona-funda py-16 md:py-24" aria-label="Diagnóstico">
			<div class="mx-auto grid max-w-7xl items-center gap-10 px-5 sm:px-6 md:grid-cols-2">
				<div>
					<span class="eyebrow !text-cyan">IA de diagnóstico</span>
					<h2 class="mt-4 text-3xl leading-tight sm:text-4xl">A IA que fala a língua do técnico.</h2>
					<p class="mt-4 max-w-md text-white/78">
						Informe o código ou descreva o sintoma. Nos <strong class="text-white">698 códigos de erro</strong> de climatização, a confiança vem em palavras: alta, média ou média/alta. No diagnóstico por sintoma, a peça entra como suspeita, sem porcentagem e sem a medida. Quem mede e troca é você.
					</p>
					<p class="mt-4 max-w-md text-white/78">
						Planos de manutenção, lembretes e o histórico de cada máquina. A ART continua sendo do responsável técnico.
					</p>
				</div>
				<div class="rounded-cartao bg-white/5 p-6 ring-1 ring-white/10">
					<div class="text-xs font-semibold uppercase tracking-wider text-cyan">Exemplo da base</div>
					<p class="mt-3 text-sm text-white/80">Daikin <span class="tnum">A6</span> · <strong class="text-cyan">falha no motor ventilador interno</strong></p>
					<p class="mt-3 text-xs font-semibold uppercase tracking-wider text-white/78">Confiança alta</p>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-24">
			<div class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
				<div>
					<span class="eyebrow">Quem faz a OLLI</span>
					<h2 class="mt-4 text-3xl tracking-tight text-ink sm:text-4xl">Feita por quem vive de campo.</h2>
					<p class="mt-4 leading-relaxed text-slate">
						A OLLI nasceu dentro da GR Tech, uma empresa de climatização em São Paulo. O texto completo está na página Sobre.
					</p>
					<a href="/sobre/" class="rodape-link font-semibold text-brand-fg">Ler a história</a>
				</div>
				<div>
					<div class="flex items-end justify-between gap-4">
						<h2 class="text-2xl text-ink">Perguntas frequentes</h2>
						<a href="/perguntas/" class="rodape-link font-semibold text-brand-fg">Ver todas</a>
					</div>
					<div class="mt-4">
						<ListaFaq itens={faq} />
					</div>
				</div>
			</div>
		</section>

		{posts.length > 0 && (
			<section class="mx-auto max-w-7xl px-5 pb-8 sm:px-6">
				<div class="flex items-end justify-between gap-4">
					<h2 class="text-2xl text-ink">Do blog</h2>
					<a href="/blog/" class="rodape-link font-semibold text-brand-fg">Todos os textos</a>
				</div>
				<ul class="mt-6 grid gap-4 md:grid-cols-3">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="cartao-link block h-full rounded-cartao border border-line bg-card p-6 shadow-e1">
								<h3 class="text-lg text-ink">{post.data.titulo}</h3>
								<p class="mt-2 text-sm leading-relaxed text-slate">{post.data.descricao}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}

		<FaixaCta
			titulo="Seu próximo orçamento pode sair em minutos."
			texto="Troque o caderno e a planilha pela OLLI. Grátis pra começar, no celular e no computador."
			href={APP_CADASTRO_URL}
			rotulo="Criar minha conta grátis"
		/>
	</main>

	<Footer />
	<script src="../scripts/session-redirect.ts"></script>
</Layout>
