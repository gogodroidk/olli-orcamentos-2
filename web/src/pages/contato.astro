---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { EMPRESA, emailContatoPublicavel, emailPrivacidadePublicavel } from "../data/empresa";

const email = emailContatoPublicavel();
const privacidade = emailPrivacidadePublicavel();
const whatsappUrl = `https://wa.me/${EMPRESA.whatsapp}`;
const schemaBreadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "OLLI", item: Astro.site?.origin },
		{ "@type": "ListItem", position: 2, name: "Contato", item: new URL("/contato/", Astro.site ?? "https://olliorcamentos.online").href },
	],
};
---

<Layout
	titulo="Contato e suporte — OLLI"
	descricao="Fale com a OLLI pelo WhatsApp ou pelo e-mail de contato. Ajuda, privacidade e exclusão de conta estão nos links desta página."
	schemas={[schemaBreadcrumb]}
>
	<Header />
	<main id="conteudo">
		<section class="mx-auto max-w-3xl px-5 py-12 sm:px-6 md:py-16">
			<p class="text-sm text-muted"><a href="/" class="rodape-link">Início</a> <span aria-hidden="true">/</span> Contato</p>
			<span class="eyebrow mt-4">Suporte</span>
			<h1 class="mt-4 text-4xl tracking-tight text-ink sm:text-5xl">Fale com a OLLI.</h1>
			<p class="mt-4 text-lg text-slate">{EMPRESA.atendimento}.</p>

			<ul class="mt-10 grid gap-4">
				<li class="rounded-cartao border border-line bg-card p-6 shadow-e1">
					<h2 class="text-lg text-ink">WhatsApp</h2>
					<p class="mt-1 text-slate">{EMPRESA.whatsappLegivel}</p>
					<a class="btn btn-primario mt-4" href={whatsappUrl}>Abrir o WhatsApp</a>
				</li>
				{email && (
					<li class="rounded-cartao border border-line bg-card p-6 shadow-e1">
						<h2 class="text-lg text-ink">E-mail</h2>
						<a class="rodape-link font-semibold text-brand-fg" href={`mailto:${email}`}>{email}</a>
					</li>
				)}
				<li class="rounded-cartao border border-line bg-card p-6 shadow-e1">
					<h2 class="text-lg text-ink">Já é cliente</h2>
					<ul class="mt-3 space-y-1 text-slate">
						<li><a class="rodape-link" href="/ajuda/">Central de Ajuda</a></li>
						<li><a class="rodape-link" href="/perguntas/">Perguntas frequentes</a></li>
						<li><a class="rodape-link" href="/excluir-conta/">Excluir conta e dados</a></li>
						<li><a class="rodape-link" href="/legal/privacidade/">Privacidade</a></li>
						<li><a class="rodape-link" href="/legal/termos/">Termos</a></li>
						{privacidade && privacidade !== email && (
							<li><a class="rodape-link" href={`mailto:${privacidade}`}>Privacidade: {privacidade}</a></li>
						)}
					</ul>
				</li>
			</ul>
		</section>
	</main>
	<Footer />
</Layout>
