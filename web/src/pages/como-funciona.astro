---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FaixaCta from "../components/site/FaixaCta.astro";
import Layout from "../layouts/Layout.astro";
import { APP_CADASTRO_URL, PASSOS } from "../data/conteudoSite";

const schemaBreadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "OLLI", item: Astro.site?.origin },
		{ "@type": "ListItem", position: 2, name: "Como funciona", item: new URL("/como-funciona/", Astro.site ?? "https://olliorcamentos.online").href },
	],
};
---

<Layout
	titulo="Como funciona a OLLI — do pedido ao recibo"
	descricao="Três passos: organize o pedido, monte o orçamento com a sua marca e envie o link. O cliente aprova e o documento vira ordem de serviço e recibo."
	schemas={[schemaBreadcrumb]}
>
	<Header />
	<main id="conteudo">
		<section class="mx-auto max-w-3xl px-5 pb-4 pt-12 sm:px-6 md:pt-16">
			<p class="text-sm text-muted"><a href="/" class="rodape-link">Início</a> <span aria-hidden="true">/</span> Como funciona</p>
			<span class="eyebrow mt-4">Como funciona</span>
			<h1 class="mt-4 text-4xl leading-[1.08] tracking-tight text-ink sm:text-5xl">Três passos. Zero planilha.</h1>
		</section>
		<section class="mx-auto max-w-7xl px-5 py-8 sm:px-6">
			<ol class="grid gap-5 md:grid-cols-3">
				{PASSOS.map((p) => (
					<li class="rounded-cartao border border-line bg-card p-7 shadow-e1">
						<div class="text-sm font-bold text-brand-fg tnum">{p.n}</div>
						<div class="mt-2 h-0.5 w-12 overflow-clip rounded-fio bg-line" aria-hidden="true">
							<div class="olli-passo-linha h-full w-full brand-gradient" style={`--olli-passo:${Number(p.n) - 1}`}></div>
						</div>
						<h2 class="mt-3 text-xl text-ink">{p.titulo}</h2>
						<p class="mt-2 text-slate">{p.texto}</p>
					</li>
				))}
			</ol>
		</section>
		<section class="mx-auto max-w-3xl px-5 py-8 text-slate sm:px-6">
			<p>
				O link vai pelo WhatsApp. Quem ouve o áudio do cliente é o prestador: a OLLI não lê conversa de WhatsApp. Ela entra na hora de montar o orçamento.
			</p>
			<p class="mt-4">
				As contas do ofício (BTU, disjuntor, tinta e as outras que já existem) ficam dentro desse orçamento.
				<a href="/para/" class="font-semibold text-brand-fg"> Veja as do seu</a>.
			</p>
		</section>
		<FaixaCta
			titulo="O primeiro orçamento é no Grátis."
			texto="Sem cartão pra testar e sem prazo pra acabar."
			href={APP_CADASTRO_URL}
			rotulo="Criar minha conta grátis"
		/>
	</main>
	<Footer />
</Layout>
