---
/**
 * /quanto-cobrar/<tema>/ — páginas "quanto cobrar por X em 2026" (SEO para a busca que o técnico faz antes de
 * mandar orçamento). Conteúdo 100% de `data/quantoCobrar.ts`: cada número é uma linha com fonte e data; o resumo é
 * CALCULADO das linhas; o FAQPage é serializado do MESMO array que a tela renderiza.
 *
 * Faixa de mercado, nunca "preço oficial". Sem aggregateRating, sem promessa de ganho.
 */
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import {
	AVISO_FAIXA,
	PAGINAS_QC,
	faixaTexto,
	resumoFaixa,
} from "../../data/quantoCobrar";

export function getStaticPaths() {
	return PAGINAS_QC.map((p) => ({ params: { tema: p.slug }, props: { p } }));
}

const { p } = Astro.props;

const APP_CADASTRO = "https://app.olliorcamentos.online/auth/login?modo=cadastro";
const cta = `${APP_CADASTRO}&utm_source=organico&utm_medium=seo&utm_campaign=quanto-cobrar-${p.utm}`;

const fontePorId = new Map(p.fontes.map((f) => [f.id, f]));
const numeroFonte = (id: string) => {
	const i = p.fontes.findIndex((f) => f.id === id);
	if (i < 0) throw new Error(`[quanto-cobrar/${p.slug}] linha cita fonte fora da lista: ${id}`);
	return i + 1;
};
const dataBR = (iso: string) => iso.split("-").reverse().join("/");

const resumo = p.resumo.map((r) => ({ ...r, ...resumoFaixa(p.linhas, r.grupo) }));

const nChars = p.descricao.length;
if (p.titulo.length < 20 || p.titulo.length > 70 || nChars < 110 || nChars > 165) {
	throw new Error(`[quanto-cobrar/${p.slug}] título/descrição fora da faixa (${p.titulo.length}/${nChars})`);
}

const schemaBreadcrumb = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "OLLI", item: Astro.site?.origin },
		{ "@type": "ListItem", position: 2, name: "Quanto cobrar", item: new URL("/quanto-cobrar/", Astro.site).href },
		{ "@type": "ListItem", position: 3, name: p.h1, item: Astro.url.href },
	],
};
const schemaFaq = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: p.faq.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
const schemaArtigo = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: p.titulo,
	inLanguage: "pt-BR",
	datePublished: p.publicadoEm,
	dateModified: p.publicadoEm,
	mainEntityOfPage: Astro.url.href,
	publisher: { "@id": `${Astro.site?.origin}#organizacao` },
};
---

<Layout titulo={p.titulo} descricao={p.descricao} schemas={[schemaBreadcrumb, schemaArtigo, schemaFaq]} ofertaDoApp={false}>
	<Header>
		<a
			href={cta}
			class="inline-flex min-h-11 items-center rounded-campo bg-brand px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-strong"
			>Começar grátis</a
		>
	</Header>

	<main id="conteudo">
		<article class="mx-auto flex max-w-4xl flex-col px-6 pb-16 pt-14">
			<nav aria-label="Você está aqui" class="text-sm text-muted">
				<a href="/" class="inline-flex min-h-11 min-w-11 items-center hover:text-brand-fg">Início</a>
				<span aria-hidden="true" class="mx-1.5">/</span>
				<span class="text-slate">Quanto cobrar</span>
			</nav>

			<h1 class="mt-4 text-balance text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold leading-[1.08] tracking-tight text-ink">
				{p.h1}
			</h1>
			<p class="mt-2 text-sm text-muted">Atualizado em {dataBR(p.publicadoEm)} · revisão prevista para {dataBR(p.revisarEm)}</p>

			<p id="resposta-curta" class="mt-6 max-w-2xl rounded-cartao border border-line bg-white px-5 py-4 text-base leading-relaxed text-ink">
				<strong class="font-bold">Resposta curta:</strong> {p.resposta}
			</p>

			<div class="mt-8 grid gap-3 sm:grid-cols-2">
				{
					resumo.map((r) => (
						<div class="rounded-cartao border border-line bg-white px-5 py-4">
							<p class="text-sm text-muted">{r.rotulo}</p>
							<p class="mt-1 text-xl font-extrabold text-ink">{faixaTexto(r)}</p>
							<p class="mt-1 text-xs text-muted">
								faixa entre {r.fontes} {r.fontes === 1 ? "fonte" : "fontes"} citadas abaixo
							</p>
						</div>
					))
				}
			</div>

			<p class="mt-6 max-w-2xl rounded-cartao border border-line bg-paper px-5 py-4 text-sm leading-relaxed text-slate">
				<strong class="font-semibold text-ink">Leia antes de usar:</strong>
				{AVISO_FAIXA}
			</p>

			<div class="mt-8">
				<a
					href={cta}
					class="inline-block rounded-acao bg-brand px-7 py-3.5 text-center text-base font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-strong"
					>Monte o orçamento grátis no OLLI</a
				>
			</div>

			<h2 class="mt-14 text-2xl font-extrabold tracking-tight text-ink">Faixas por serviço, com a fonte de cada número</h2>
			<div class="mt-5 overflow-x-auto rounded-cartao border border-line bg-white">
				<table class="w-full min-w-[640px] border-collapse text-left text-sm">
					<caption class="sr-only">{p.h1}: faixas de preço por serviço e fonte</caption>
					<thead class="bg-paper text-ink">
						<tr>
							<th scope="col" class="px-4 py-3 font-semibold">Serviço</th>
							<th scope="col" class="px-4 py-3 font-semibold">Faixa</th>
							<th scope="col" class="px-4 py-3 font-semibold">Unidade</th>
							<th scope="col" class="px-4 py-3 font-semibold">Fonte</th>
						</tr>
					</thead>
					<tbody>
						{
							p.linhas.map((l) => (
								<tr class="border-t border-line align-top">
									<td class="px-4 py-3 text-ink">
										{l.servico}
										{l.obs && <span class="mt-0.5 block text-xs text-muted">{l.obs}</span>}
										{l.foraDaFaixa && <span class="mt-0.5 block text-xs font-semibold text-muted">fora do resumo (valor atípico)</span>}
										{l.ilustrativo && <span class="mt-0.5 block text-xs font-semibold text-muted">ilustrativo, fora do resumo</span>}
									</td>
									<td class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{faixaTexto(l)}</td>
									<td class="px-4 py-3 text-slate">{l.unidade}</td>
									<td class="px-4 py-3 text-slate">
										<a href={`#fonte-${numeroFonte(l.fonte)}`} class="underline hover:text-brand-fg">
											[{numeroFonte(l.fonte)}] {fontePorId.get(l.fonte)!.nome.split(" — ")[0]}
										</a>
										<span class="block text-xs text-muted">{dataBR(fontePorId.get(l.fonte)!.data)}</span>
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>

			{
				p.secoes.map((s) => (
					<section class="mt-12 max-w-3xl">
						<h2 class="text-2xl font-extrabold tracking-tight text-ink">{s.titulo}</h2>
						{s.paragrafos.map((t) => (
							<p class="mt-4 text-base leading-relaxed text-slate">{t}</p>
						))}
						{s.itens && (
							<ul class="mt-4 list-disc space-y-2 pl-6 text-base leading-relaxed text-slate">
								{s.itens.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						)}
					</section>
				))
			}

			<section class="mt-12 max-w-3xl rounded-cartao border border-line bg-white px-6 py-6">
				<h2 class="text-xl font-extrabold tracking-tight text-ink">Onde a OLLI entra</h2>
				<p class="mt-3 text-base leading-relaxed text-slate">{p.ponteOlli}</p>
				<a
					href={cta}
					class="mt-5 inline-block rounded-acao bg-brand px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-brand-strong"
					>Monte o orçamento grátis no OLLI</a
				>
			</section>

			<section class="mt-12 max-w-3xl">
				<h2 class="text-2xl font-extrabold tracking-tight text-ink">Perguntas frequentes</h2>
				<div class="mt-4 divide-y divide-line rounded-cartao border border-line bg-white">
					{
						p.faq.map((f) => (
							<details class="group px-5 py-4">
								<summary class="cursor-pointer list-none text-base font-semibold text-ink">{f.q}</summary>
								<p class="mt-3 text-base leading-relaxed text-slate">{f.a}</p>
							</details>
						))
					}
				</div>
			</section>

			<section class="mt-12 max-w-3xl">
				<h2 class="text-xl font-extrabold tracking-tight text-ink">Leia também</h2>
				<ul class="mt-3 space-y-2 text-base">
					{p.leiaTambem.map((l) => <li><a href={l.href} class="text-brand-fg underline">{l.texto}</a></li>)}
				</ul>
			</section>

			<section id="fontes" class="mt-12 max-w-3xl border-t border-line pt-8">
				<h2 class="text-xl font-extrabold tracking-tight text-ink">Fontes</h2>
				<p class="mt-2 text-sm text-muted">
					Valores conferidos nas páginas abaixo em novembro de 2026. Preço de serviço muda: confira a data de cada fonte.
				</p>
				<ol class="mt-4 space-y-2 text-sm text-slate">
					{
						p.fontes.map((f, i) => (
							<li id={`fonte-${i + 1}`}>
								[{i + 1}] <a href={f.url} rel="noopener noreferrer nofollow" class="underline hover:text-brand-fg">{f.nome}</a>
								{f.regiao ? ` — ${f.regiao}` : ""} · {dataBR(f.data)}
							</li>
						))
					}
				</ol>
			</section>
		</article>
	</main>

	<Footer />
</Layout>
