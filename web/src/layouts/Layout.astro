---
import Cabeca from "../components/Cabeca.astro";
import "../styles/global.css";

interface Props {
	titulo?: string;
	descricao?: string;
	/**
	 * JSON-LD EXTRA da página (FAQPage, BreadcrumbList…). O `Organization` e o
	 * `SoftwareApplication` já saem em toda página de produto por padrão — a página
	 * só manda o que é dela. `/servicos/` passa `ofertaDoApp={false}`: o valor do
	 * serviço não é o preço do app. Cada item vira uma tag `<script type="application/ld+json">`.
	 */
	schemas?: unknown[];
	/** false na página de serviços, para o schema não anunciar Pro/Empresa como preço do pacote. */
	ofertaDoApp?: boolean;
	/** Dígitos com DDI. Padrão: WhatsApp do app. A página de serviços passa o número do segundo andar. */
	telefoneContato?: string;
	/** Nome no schema WebSite. Padrão: OLLI Orçamentos. */
	nomeDoSite?: string;
	/**
	 * Páginas que não devem ser indexadas (404, por exemplo) passam `noindex`.
	 * Sem isso o buscador pode indexar uma página de erro como se fosse conteúdo.
	 */
	noindex?: boolean;
	/** Imagem de compartilhamento (og:image/twitter:image) própria da página, caminho absoluto no site (`/og/eletricista.png`). Sem ela, o banner genérico. 1200×630, <300 KB (limite do WhatsApp). */
	ogImagem?: string;
	/** Redirecionamento HTML para portas estáticas, com link visível de fallback. */
	redirectUrl?: string;
	/**
	 * Caminho canônico quando a página é uma VARIANTE de outra (ex.: página de anúncio /eletricista/ → /para/eletricista/).
	 * Só muda o <link rel="canonical"> e o og:url; a página continua acessível e INDEXÁVEL no sentido do robots
	 * (o Pixel/UTM de `scripts/marketing.ts` morre em página noindex). Deve ser um caminho absoluto com barra final.
	 */
	canonicalPath?: string;
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <Cabeca {...Astro.props} />
  </head>
  <body>
    <slot />
    {/* Origem da visita (UTM) + Meta Pixel. Bundle próprio: não é <script> inline,
        então não entra no hash do CSP. Páginas noindex se excluem sozinhas. */}
    <script src="../scripts/marketing.ts"></script>
  </body>
</html>
