# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
qa-artifacts/
artifacts/

# macOS
.DS_Store
*.pem

# local env files — qualquer .env* (inclusive .env.production/.env.staging),
# menos os modelos versionados de propósito.
.env
.env.*
.env*.local
!.env.example
!**/.env.example
# Secrets locais do Wrangler (`wrangler dev` lê daqui) — mesmo valor do `secret put`.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Artefatos de QA/ferramentas locais — nao pertencem ao repo
.playwright-mcp/
.codex/
qa-artifacts/

# Credenciais de assinatura (NUNCA no repositorio)
credentials.json
*.keystore
*.pfx
# Cofre local e contas de serviço (Google/Firebase) — o cofre fica fora do repo.
credenciais-locais*.env
*service-account*.json
google-services.json
GoogleService-Info.plist

# Dumps de banco (produção tem dado de cliente — LGPD): nunca versionar.
*.dump
*.sql.gz
*.backup
dump*.sql
**/supabase/backups/

# QC screenshots da sessao (nao sao deliverables)
/*.png
/tmp/
.claude/launch.json

# Cache local do Wrangler; regenerado automaticamente e nunca versionado.
/.wrangler/

# Gerados localmente (grafo do graphify, cache do Supabase CLI)
graphify-out/
supabase/.temp/

# Logs do CI local (scripts/ci-local.sh)
.ci-local/

# Canvas do Maestri (pastas de papel dos agentes) — local, nunca vai pro repo
.maestri/
