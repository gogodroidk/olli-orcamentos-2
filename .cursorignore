# dumps e sementes do banco
*.dump
*.sql.gz
*.bak.sql
**/dump*.sql
supabase/seed*
**/supabase/seed*
.dev.vars*
**/.dev.vars*
*service-account*.json
**/*service-account*.json
*-sa.json
**/*-sa.json
