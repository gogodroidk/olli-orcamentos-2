{
	"$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**",
			"App.tsx",
			"index.ts",
			"scripts/**",
			"plugins/**",
			"ops/**",
			"worker/src/**",
			"worker/scripts/**",
			"!**/*.json"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
