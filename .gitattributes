# Scripts de shell precisam de LF mesmo com core.autocrlf=true (o bash do Windows quebra com CR no fim da linha).
*.sh text eol=lf
# Hooks versionados (sem extensão) também precisam de LF: bash falha com CR no fim da linha.
.githooks/* text eol=lf

# Migrations SQL sempre com LF no checkout (core.autocrlf=true no Windows gravava \r nas funcoes e quebrava remendos por ancora).
*.sql text eol=lf
